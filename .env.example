# CricketVerse Arena - example environment.
# Copy to .env if you need to change anything. Nothing here is secret, and the game runs without a .env file.

# Port for the Node game server (npm run server / npm start).
PORT=3001

# Maximum simultaneous rooms on one server.
MAX_ROOMS=500

# Only set this if the client is hosted somewhere other than the game server,
# e.g. a static site on another domain. Defaults to the page's own origin.
# VITE_SERVER_URL=https://your-game-server.example.com
