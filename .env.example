# Environment Variables
# Copy this file to .env and fill in your values

# === Firebase Configuration ===
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# === Application ===
VITE_APP_NAME=CricketVerse
VITE_APP_ENV=development
VITE_SITE_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000

# === Monitoring ===
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

# === Feature Flags ===
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_ACHIEVEMENTS=true
VITE_ENABLE_ADVANCED_COMMENTARY=true

# === Rate Limiting (client-side) ===
VITE_MAX_MATCHES_PER_DAY=20
VITE_MAX_TOURNAMENTS_PER_USER=5

# === Firebase Emulators ===
VITE_USE_EMULATORS=false
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_HOST=http://localhost:9099
VITE_STORAGE_EMULATOR_HOST=localhost:9199
